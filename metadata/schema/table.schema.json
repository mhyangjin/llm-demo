{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sendy Table Metadata",
  "type": "object",
  "required": [
    "table_name",
    "business_name",
    "description",
    "owner",
    "columns"
  ],
  "properties": {
    "table_name": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "refresh_cycle": {
      "type": "string"
    },
    "joins": {
      "type": "array"
    },
    "columns": {
      "type": "array"
    }
  }
}